# 複製這個檔案成 .env，再填入你自己的值。
# .env 已列在 .gitignore，不會被上傳到 GitHub。

# --- Email 通知（第 1 階段會用到）---
# Gmail 需要先開啟兩步驟驗證，再到 Google 帳戶建立「應用程式密碼」
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 收件人，留空則寄給 GMAIL_ADDRESS 自己
NOTIFY_TO=

# --- AI 摘要（第 4 階段會用到）---
# anthropic 或 openai
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
